# Asuna — ornek yapilandirma (PROJECT.md Bolum 23)
# Bu dosyayi `.env` olarak kopyala ve doldur. GERCEK SECRET COMMIT EDILMEZ.
# Not: OPENAI_API_KEY ve PICOVOICE_ACCESS_KEY sadece guvenilir process (Tauri Rust tarafi)
# tarafindan okunur; renderer/webview bundle'ina asla girmez (bkz. DECISIONS.md ADR-006).

# OpenAI API anahtari — Realtime ephemeral token uretimi icin, SADECE Rust tarafinda okunur.
OPENAI_API_KEY=

# Kullanilacak Realtime modeli. Dev/ekonomi icin: gpt-realtime-2.1-mini. Model ID hicbir yerde hard-code edilmez.
ASUNA_REALTIME_MODEL=gpt-realtime-2.1

# Asuna'nin ses (voice) kimligi. Bos birakilirsa SDK varsayilani kullanilir.
ASUNA_REALTIME_VOICE=

# Lokal wake word tetikleyici ifadesi. Porcupine custom keyword bununla eslesmeli.
ASUNA_WAKE_WORD=Hey Asuna

# Kalici memory katmani acik mi (false = sadece oturum ici baglam, hicbir sey saklanmaz).
ASUNA_MEMORY_ENABLED=true

# Ham konusma transkriptleri diske yazilsin mi (false = sadece oturum ozeti saklanir).
ASUNA_TRANSCRIPT_STORAGE=true

# Tool onay politikasi: safe = riskli/yazma islemleri kullanici onayi ister (varsayilan ve onerilen).
ASUNA_TOOL_APPROVAL_MODE=safe

# Konusma bittikten sonra oturumun kapanip idle'a donmesi icin beklenecek sure (saniye).
ASUNA_IDLE_TIMEOUT_SECONDS=45

# Log seviyesi: error | warn | info | debug. Log'larda secret redakte edilir.
ASUNA_LOG_LEVEL=info

# Picovoice Porcupine access key — lokal wake word tespiti icin gerekli (Phase 2), sadece Rust tarafinda okunur.
PICOVOICE_ACCESS_KEY=

# Wake word saglayicisi — `WakeWordProvider` adapter'inin hangi implementasyonu secilecegi (ADR-004).
ASUNA_WAKE_WORD_PROVIDER=porcupine
