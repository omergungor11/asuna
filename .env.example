# Asuna — ornek yapilandirma (PROJECT.md Bolum 23, ASU-009)
# Bu dosyayi `.env` olarak kopyala ve doldur. GERCEK SECRET COMMIT EDILMEZ.
#
# Nasil okunur: `.env` yalnizca Tauri'nin Rust tarafinda okunur (src-tauri/src/config.rs).
# Renderer'a yalnizca whitelist'lenmis bir alt kume gecer (`get_frontend_config` komutu).
# Asagidaki degiskenlerin TAMAMI tanimli olmali — eksik/gecersiz deger uygulamayi acilista
# net bir hata mesajiyla durdurur; sessizce varsayilana dusulmez.
# Bos birakilabilen tek istisnalar: ASUNA_REALTIME_VOICE ve ASUNA_WAKE_WORD_MODEL_DIR.
# Process environment bu dosyayi ezer. `.env`'in yeri: calisma dizini ve ust dizinleri;
# `ASUNA_ENV_FILE=/mutlak/yol/.env` ile acikca da verilebilir.

# OpenAI API anahtari — Realtime ephemeral token uretimi icin, SADECE Rust tarafinda okunur, renderer bundle'ina girmez.
OPENAI_API_KEY=

# Kullanilacak Realtime modeli; dev/ekonomi icin `gpt-realtime-2.1-mini` (model ID hicbir yerde hard-code edilmez).
ASUNA_REALTIME_MODEL=gpt-realtime-2.1

# Oturum ozeti ureten metin modeli (ASU-033). Realtime modelinden AYRI bir cagri; ozet icin realtime modeli kullanilmaz.
# Bu deger renderer'a gitmez, ozet cagrisi Rust tarafinda yapilir. `gpt-4o-mini` 2026-08-24'te canli probe ile dogrulandi.
ASUNA_SUMMARY_MODEL=gpt-4o-mini

# Asuna'nin ses kimligi: alloy|ash|ballad|coral|echo|sage|shimmer|verse|marin|cedar — bos birakilirsa SDK varsayilani kullanilir.
ASUNA_REALTIME_VOICE=

# Lokal wake word tetikleyici ifadesi; KWS keyword listesi bununla eslesmeli.
ASUNA_WAKE_WORD=Hey Asuna

# Kalici memory katmani acik mi: true|false (false = sadece oturum ici baglam, hicbir sey saklanmaz).
ASUNA_MEMORY_ENABLED=true

# Ham konusma transkriptleri diske yazilsin mi: true|false (false = sadece oturum ozeti saklanir).
ASUNA_TRANSCRIPT_STORAGE=true

# Tool onay politikasi: safe (onerilen) | always — risk 2/3 tool'lar her iki modda da her zaman onay ister, bu ayar onlari bypass edemez.
ASUNA_TOOL_APPROVAL_MODE=safe

# Konusma bittikten sonra oturumun kapanip idle'a donmesi icin beklenecek sure: 5-1800 saniye.
ASUNA_IDLE_TIMEOUT_SECONDS=45

# Log seviyesi: error|warn|info|debug (log'larda secret redakte edilir).
ASUNA_LOG_LEVEL=info

# Wake word saglayicisi: sherpa-kws (ADR-004, sherpa-onnx KeywordSpotter) | fake (test/gelistirme, mikrofon acmaz).
ASUNA_WAKE_WORD_PROVIDER=sherpa-kws

# KWS model dosyalarinin dizini (encoder/decoder/joiner/tokens); bos = uygulama varsayilan konumu.
ASUNA_WAKE_WORD_MODEL_DIR=

# Wake word tetikleme esigi: 0 (haric) - 1 (dahil); yuksek deger = daha az yanlis tetik, daha cok kacirma.
ASUNA_WAKE_WORD_THRESHOLD=0.25

# Tur tespiti: semantic_vad (model anlamdan karar verir, onerilen) | server_vad (sabit sessizlik esigi).
ASUNA_TURN_DETECTION=semantic_vad

# semantic_vad acikgozlulugu: auto|low|medium|high — yuksek = daha hizli cevap, dusuk = tumce ortasi duraklamada erken kesme riski daha az.
ASUNA_VAD_EAGERNESS=high

# server_vad sessizlik penceresi: 100-2000 ms — dusuk = daha hizli cevap ama erken kesme, yuksek = gec ama sabirli (semantic_vad'de kullanilmaz).
ASUNA_VAD_SILENCE_MS=400
